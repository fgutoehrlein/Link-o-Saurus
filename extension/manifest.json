{
  "manifest_version": 3,
  "name": "Link-o-Saurus",
  "version": "0.1.0",
  "description": "Offline-first bookmark manager for saving, organizing, searching, and restoring links.",
  "icons": {
    "16": "assets/link-o-saurus-icon.png",
    "48": "assets/link-o-saurus-icon.png",
    "128": "assets/link-o-saurus-icon.png"
  },
  "action": {
    "default_icon": "assets/link-o-saurus-icon.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "contextMenus",
    "alarms",
    "scripting",
    "activeTab",
    "bookmarks",
    "sidePanel"
  ],
  "optional_permissions": [
    "tabs",
    "windows"
  ],
  "host_permissions": [],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      }
    },
    "open-side-panel": {
      "description": "Open Link-o-Saurus side panel",
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      }
    }
  }
}
